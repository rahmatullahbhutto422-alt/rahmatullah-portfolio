
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    background: #0b1120;
    color: #ffffff;
    line-height: 1.7;
}

header {
    background: #111c32;
    position: sticky;
    top: 0;
    z-index: 100;
}

.navbar {
    max-width: 1100px;
    margin: auto;
    padding: 18px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    color: white;
}

.logo span,
.hero h1 span {
    color: #38bdf8;
}

.nav-links {
    display: flex;
    list-style: none;
    gap: 25px;
}

.nav-links a {
    color: white;
    text-decoration: none;
}

.nav-links a:hover {
    color: #38bdf8;
}

.menu-btn {
    display: none;
    background: transparent;
    border: none;
    color: white;
    font-size: 25px;
}

.hero {
    min-height: 85vh;
    display: flex;
    align-items: center;
    padding: 60px 10%;
    background: linear-gradient(135deg, #0b1120, #172d4e);
}

.hero-content {
    max-width: 750px;
}

.welcome {
    color: #38bdf8;
    letter-spacing: 3px;
}

.hero h1 {
    font-size: 45px;
    margin: 15px 0;
}

.hero h2 {
    color: #b9c9dc;
    margin-bottom: 15px;
}

.hero-content > p:not(.welcome) {
    color: #cbd5e1;
    margin-bottom: 25px;
}

.btn {
    display: inline-block;
    background: #0284c7;
    color: white;
    padding: 12px 22px;
    border: none;
    border-radius: 6px;
    text-decoration: none;
    cursor: pointer;
    margin: 5px 5px 5px 0;
}

.btn:hover {
    background: #0369a1;
}

.outline {
    background: transparent;
    border: 1px solid #38bdf8;
}

.section {
    padding: 70px 10%;
    text-align: center;
}

.section h2 {
    color: #38bdf8;
    font-size: 30px;
    margin-bottom: 25px;
}

.section > p {
    max-width: 750px;
    margin: auto;
    color: #cbd5e1;
}

.info {
    margin-top: 25px;
    color: #dbeafe;
}

.cards,
.project-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 20px;
    margin-top: 25px;
}

.card,
.project {
    background: #17243a;
    padding: 25px;
    border-radius: 10px;
    border: 1px solid #29415e;
}

.card:hover,
.project:hover {
    transform: translateY(-5px);
    border-color: #38bdf8;
    transition: 0.3s;
}

.project h3 {
    color: #38bdf8;
    margin-bottom: 12px;
}

.project p {
    color: #cbd5e1;
}

#contact form {
    max-width: 500px;
    margin: 25px auto;
    display: flex;
    flex-direction: column;
    gap: 15px;
}

input,
textarea {
    width: 100%;
    padding: 14px;
    border: 1px solid #29415e;
    border-radius: 6px;
    background: #17243a;
    color: white;
    font-size: 15px;
}

textarea {
    min-height: 120px;
    resize: vertical;
}

footer {
    background: #111c32;
    text-align: center;
    padding: 25px;
    color: #cbd5e1;
}

#formStatus {
    color: #38bdf8;
}

@media (max-width: 650px) {
    .menu-btn {
        display: block;
    }

    .nav-links {
        display: none;
        position: absolute;
        top: 65px;
        left: 0;
        width: 100%;
        background: #111c32;
        flex-direction: column;
        text-align: center;
        padding: 20px;
        gap: 15px;
    }

    .nav-links.active {
        display: flex;
    }

    .hero {
        min-height: 75vh;
        padding: 50px 7%;
    }

    .hero h1 {
        font-size: 34px;
    }

    .section {
        padding: 55px 7%;
    }
}
